# Copie para .env.local. Nada aqui é segredo exceto SESSION_SECRET (gere um valor próprio).
# URL pública do app (usada no redirect_uri do OIDC).
APP_BASE_URL=http://localhost:3000
# Issuer do IdP (Keycloak local do infrastructure/docker-compose.yml).
OIDC_ISSUER_URI=http://localhost:8180/realms/smart-health-finance
OIDC_CLIENT_ID=shf-web
# API Spring Boot (só o servidor Next.js fala com ela).
API_BASE_URL=http://localhost:8080
# Chave que sela o cookie de sessão (mínimo 32 caracteres). Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# SÓ para rodar o build de produção na própria máquina (pnpm build && pnpm start) em http://localhost.
# Em produção (NODE_ENV=production) o app NÃO sobe com APP_BASE_URL em http:// — ver ADR-0007 §9.
# Só vale para host de loopback (localhost/127.0.0.1/[::1]). Nunca defina em staging/produção.
# SHF_ALLOW_INSECURE_LOCALHOST=true
