# Smart Health Finance — modelo de variáveis do backend para o ambiente LOCAL.
#
# Copie para backend/.env (ignorado pelo Git) e preencha os valores em branco com credenciais
# de desenvolvimento de sua escolha. Nenhum valor sensível é versionado: sem .env preenchido,
# o Docker Compose e a API falham na inicialização em vez de usar defaults.
#
# O mesmo arquivo é lido por:
#   - Spring Boot (perfil "local"): spring.config.import em application-local.yml.
#     Execute a API a partir do diretório backend/.
#   - Docker Compose: docker compose --env-file backend/.env -f infrastructure/docker-compose.yml up -d
#   - infrastructure/scripts/local-token.sh
#
# Formato KEY=value, sem aspas e sem espaços (compatível com .properties e com o Compose).
# Nunca coloque segredos ou dados reais aqui.

# --- PostgreSQL (source of truth) ---
DB_NAME=shf
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/shf
DB_USERNAME=
DB_PASSWORD=

# --- Redis (cache/rate limit; nunca source of truth) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ (async + outbox) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Keycloak (IdP OIDC local) ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
OIDC_ISSUER_URI=http://localhost:8180/realms/smart-health-finance

# Usuários sintéticos criados no realm local (infrastructure/keycloak/realm-smart-health-finance.json)
# e usados por infrastructure/scripts/local-token.sh. Use e-mails fictícios (ex.: @example.com).
SHF_DEV_CLIENT_ID=shf-web
SHF_DEV_ANA_USERNAME=
SHF_DEV_ANA_PASSWORD=
SHF_DEV_BRUNO_USERNAME=
SHF_DEV_BRUNO_PASSWORD=

# --- API ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Observabilidade (suba com --profile observability e troque para true) ---
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend em container (docker compose --profile app) ---
# Sela o cookie de sessão do Next.js (mín. 32 caracteres). Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEB_SESSION_SECRET=
