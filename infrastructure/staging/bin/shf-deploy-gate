#!/bin/bash
# Gate do SSH de deploy (ADR-0044 §5 item 23). Instalado em /usr/local/bin (root, 0755) e configurado como
# comando forçado da chave do usuário `deploy`:
#
#   restrict,command="/usr/local/bin/shf-deploy-gate" ssh-ed25519 AAAA... github-actions-staging
#
# Aceita SÓ "deploy <sha-40-hex> <sha256:64-hex> <sha256:64-hex>". Qualquer outra coisa é recusada.
# Os valores validados viram argumentos do sudo (nunca eval nem shell). O shf-deploy revalida.
set -euo pipefail

SHF_GATE_RE='^deploy ([0-9a-f]{40}) (sha256:[0-9a-f]{64}) (sha256:[0-9a-f]{64})$'

# Imprime "sha digest-api digest-web" (separados por espaço) se o comando for válido; senão, retorna 1.
# A expressão é ancorada no texto inteiro: quebra de linha, `;`, `$(...)`, espaços extras e maiúsculas falham.
shf_gate_parse() {
	local command=${1-}
	(( ${#command} <= 200 )) || return 1
	[[ "$command" =~ $SHF_GATE_RE ]] || return 1
	printf '%s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

shf_gate_main() {
	local parsed sha api web
	if ! parsed=$(shf_gate_parse "${SSH_ORIGINAL_COMMAND-}"); then
		echo "comando recusado: use 'deploy <sha> <digest-api> <digest-web>'" >&2
		logger -t shf-deploy-gate "comando recusado"
		exit 64
	fi
	read -r sha api web <<<"$parsed"
	logger -t shf-deploy-gate "deploy aceito sha=$sha"
	# Queda do SSH no meio não pode matar o deploy (o resultado fica no deployments.log).
	trap '' HUP PIPE
	exec sudo -n /usr/local/bin/shf-deploy "$sha" "$api" "$web"
}

# Executa só quando chamado diretamente (os testes fazem `source` para testar shf_gate_parse).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	shf_gate_main
fi
