{
  "realm": "smart-health-finance",
  "displayName": "Smart Health Finance (staging)",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notEmail and notUsername and passwordHistory(3)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "staging-no-reply@example.com",
    "fromDisplayName": "Smart Health Finance (staging)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "shf-web",
      "name": "Smart Health Finance Web (staging)",
      "description": "Cliente público, PKCE S256, só fluxo de código (ADR-0043 §7). Logout só por back-channel (ADR-0008).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://${STAGING_APP_HOST}/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": ""
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": []
    },
    {
      "clientId": "shf-staging-seed",
      "name": "Seed do staging (desligado)",
      "description": "Só no staging (ADR-0044 §2 item 8). Fica desligado; o shf-seed o liga durante o seed e o desliga em seguida, inclusive em falha. Não existe no realm de produção.",
      "enabled": false,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SEED_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": []
    }
  ]
}
