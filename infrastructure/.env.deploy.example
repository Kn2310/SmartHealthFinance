# Modelo de variáveis para STAGING / PRODUCTION (infrastructure/docker-compose.deploy.yml).
#
# NÃO preencha este arquivo com valores reais. Crie uma cópia FORA do repositório, por ambiente,
# com permissão restrita (ex.: /etc/shf/staging.env e /etc/shf/production.env, chmod 600),
# ou gere-a a partir do secret manager no deploy (specs 05.5/05.11).
# Nunca reutilize senhas entre staging e produção.

# staging | production
DEPLOY_ENV=staging

# Imagem por digest (nunca :latest)
API_IMAGE=ghcr.io/CHANGE_ME/smart-health-finance-api@sha256:CHANGE_ME
API_HOST_PORT=8080

# --- PostgreSQL ---
DB_NAME=shf
DB_USERNAME=shf_app
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- RabbitMQ ---
RABBITMQ_USERNAME=shf_app
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- OIDC (IdP do ambiente; precisa ser alcançável pela API) ---
OIDC_ISSUER_URI=https://CHANGE_ME/realms/smart-health-finance

# --- API ---
CORS_ALLOWED_ORIGINS=https://CHANGE_ME
API_DOCS_ENABLED=false

# --- Observabilidade ---
OTEL_EXPORT_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE_ME:4318
TRACING_SAMPLING_PROBABILITY=0.1
