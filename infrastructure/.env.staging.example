# Modelo do env file do STAGING (ADR-0044 §6). NÃO preencha este arquivo no repositório.
#
# No host: copie para /etc/shf/staging.env, preencha e proteja:
#   sudo install -m 600 -o root -g root infrastructure/.env.staging.example /etc/shf/staging.env
#   sudoedit /etc/shf/staging.env
#
# Formato: NOME=valor, uma por linha, sem aspas e sem espaços em volta do "=".
# Toda senha/segredo: aleatório, só do staging, nunca reutilizado em outro ambiente. Gere cada um com:
#   openssl rand -hex 32
# O arquivo nunca é impresso pelos scripts, nem copiado para imagem, log ou artefato de CI.
# As imagens (API_IMAGE e WEB_IMAGE) NÃO ficam aqui: ficam em /etc/shf/staging.images, escrito só pelo shf-deploy.

# --- Nomes públicos (DNS A/AAAA para o IP estático do Lightsail) ---
STAGING_APP_HOST=app.staging.CHANGE_ME
STAGING_AUTH_HOST=auth.staging.CHANGE_ME
# E-mail da conta ACME (avisos de expiração do Let's Encrypt).
ACME_EMAIL=CHANGE_ME

# --- PostgreSQL da aplicação ---
DB_NAME=shf
DB_USERNAME=shf_app
DB_PASSWORD=CHANGE_ME_RANDOM

# --- PostgreSQL do Keycloak (database e usuário próprios, ADR-0043 §3) ---
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_RANDOM

# --- Redis e RabbitMQ ---
REDIS_PASSWORD=CHANGE_ME_RANDOM
RABBITMQ_USERNAME=shf_app
RABBITMQ_PASSWORD=CHANGE_ME_RANDOM

# --- Keycloak: admin de bootstrap (console só pelo túnel SSH, 127.0.0.1:8180) ---
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_RANDOM

# --- BFF: segredo do cookie selado (mínimo 32 caracteres) ---
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX

# --- Seed fictício (ADR-0044 §8). Usuários SÓ @example.com; senhas com 12+ caracteres. ---
SEED_CLIENT_SECRET=CHANGE_ME_RANDOM
SEED_MARINA_USERNAME=marina.staging@example.com
SEED_MARINA_PASSWORD=CHANGE_ME_RANDOM
SEED_BRUNO_USERNAME=bruno.staging@example.com
SEED_BRUNO_PASSWORD=CHANGE_ME_RANDOM

# --- Observabilidade (Grafana só pelo túnel SSH, 127.0.0.1:3001) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_RANDOM
# Bot do Telegram criado por você (@BotFather) e o chat que recebe os alertas.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# --- Copilot (ADR-0044 §10). Começa simulado; o provedor real é da Parte E, feito por você. ---
COPILOT_ENABLED=true
COPILOT_PROVIDER=simulated
ANTHROPIC_API_KEY=
